      "source": [
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.preprocessing import MinMaxScaler, StandardScaler\n",
        "\n",
        "# Target file path\n",
        "file_path = '/content/fraudTest.csv'\n",
        "\n",
        "if not os.path.exists(file_path):\n",
        "    print(f\"Error: File not found at {file_path}\")\n",
        "else:\n",
        "    print(f\"\\n{'='*20} Processing: {os.path.basename(file_path)} {'='*20}\")\n",
        "\n",
        "    # 1. Load the Dataset\n",
        "    df_test = pd.read_csv(file_path)\n",
        "\n",
        "    # 2. Binning (Discretisation)\n",
        "    amt_bins = [0, 50, 500, 2000, np.inf]\n",
        "    bin_labels = ['Low', 'Medium', 'High', 'Very High']\n",
        "    df_test['Amt_Category'] = pd.cut(df_test['amt'], bins=amt_bins, labels=bin_labels)\n",
        "\n",
        "    print(\"\\n Binning Distribution Counts:\")\n",
        "    print(df_test['Amt_Category'].value_counts())\n",
        "\n",
        "    # 3. Outlier Detection and Filtering\n",
        "    outlier_threshold = 3000\n",
        "    outliers = df_test[df_test['amt'] > outlier_threshold]\n",
        "    print(f\"\\n Outlier Detection:\")\n",
        "    print(f\"Total outliers exceeding ${outlier_threshold}: {len(outliers)}\")\n",
        "    if len(outliers) > 0:\n",
        "        print(\"Sample outlier rows:\")\n",
        "        print(outliers[['cc_num', 'amt', 'merchant']].head(3))\n",
        "\n",
        "    # 4. Data Transformation (Feature Scaling)\n",
        "    min_max_scaler = MinMaxScaler()\n",
        "    df_test['amt_normalized'] = min_max_scaler.fit_transform(df_test[['amt']])\n",
        "\n",
        "    standard_scaler = StandardScaler()\n",
        "    df_test['amt_standardized'] = standard_scaler.fit_transform(df_test[['amt']])\n",
        "\n",
        "    print(\"\\n Data Transformation (Feature Scaling Samples):\")\n",
        "    print(df_test[['amt', 'amt_normalized', 'amt_standardized']].head(5))\n"
      ],
